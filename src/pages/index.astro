---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Architecture from '../components/Architecture.astro';
import WarStories from '../components/WarStories.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
---

<Layout>
  <Header locale="es" />

  <main id="main" tabindex="-1">
    <Hero locale="es" />
    <Experience locale="es" />
    <Projects locale="es" />
    <TechStack locale="es" />
    <Architecture locale="es" />
    <WarStories locale="es" />
  </main>

  <Footer locale="es" />
  <CommandPalette locale="es" />
</Layout>
