---
import ThemeToggle from './ThemeToggle.astro';
import { SOCIAL, getPortfolioData, type Locale } from '../data/portfolio.data';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const data = getPortfolioData(locale);
const { nav: t } = data.ui;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isHome = pathname === '' || pathname === baseUrl || pathname === `${baseUrl}/en`;

const homePrefix = locale === 'en' ? `${baseUrl}/en` : (baseUrl || '');

const navLinks = [
  { label: t.letter,       href: isHome ? '#letter' : `${homePrefix}/#letter` },
  { label: t.services,     href: isHome ? '#services' : `${homePrefix}/#services` },
  { label: t.experience,   href: isHome ? '#experience' : `${homePrefix}/#experience` },
  { label: t.projects,     href: isHome ? '#projects' : `${homePrefix}/#projects` },
  { label: t.architecture, href: isHome ? '#architecture' : `${homePrefix}/#architecture` },
  { label: t.warStories,   href: isHome ? '#war-stories' : `${homePrefix}/#war-stories` },
  { label: t.contact,      href: isHome ? '#contact' : `${homePrefix}/#contact` },
];
---

<header
  class="sticky top-0 z-40 border-b border-rim bg-canvas/90 backdrop-blur-md"
  role="banner"
>
  <div class="wrap">
    <div class="flex items-center justify-between h-14 gap-4">

      <!-- Brand -->
      <a
        href={homePrefix || '/'}
        class="flex items-center gap-2.5 shrink-0 group"
        aria-label="Inicio — Ezequiel Gonzalez"
      >
        <span
          class="w-8 h-8 flex items-center justify-center bg-gold text-canvas font-display font-medium text-xs rounded-sm"
          aria-hidden="true"
        >
          EG
        </span>
        <span class="font-display text-sm text-ink group-hover:text-gold transition-colors hidden sm:inline">
          ezequiel<span class="text-gold">.</span>dev
        </span>
      </a>

      <!-- Nav desktop -->
      <nav class="hidden lg:flex items-center gap-6" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs text-ink-2 hover:text-gold transition-colors tracking-wide"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2.5 ml-auto lg:ml-0">
        <!-- Command Palette Trigger Button -->
        <button
          type="button"
          data-open-cmd
          class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded border border-rim bg-surface-2 text-ink-3 hover:text-gold hover:border-gold/50 transition-colors font-mono text-2xs cursor-pointer"
          title="Command Palette (Ctrl+K / Cmd+K)"
          aria-label="Abrir barra de comandos"
        >
          <span class="text-gold">⌘</span>
          <span>K</span>
        </button>

        <!-- Language Switcher -->
        <div class="flex items-center border border-rim rounded overflow-hidden font-mono text-2xs">
          <a
            href={`${baseUrl}/`}
            class:list={[
              'px-2 py-1 transition-colors',
              locale === 'es' ? 'bg-gold text-canvas font-semibold' : 'text-ink-3 hover:text-ink bg-surface',
            ]}
            aria-label="Versión en Español"
          >
            ES
          </a>
          <a
            href={`${baseUrl}/en/`}
            class:list={[
              'px-2 py-1 transition-colors',
              locale === 'en' ? 'bg-gold text-canvas font-semibold' : 'text-ink-3 hover:text-ink bg-surface',
            ]}
            aria-label="English Version"
          >
            EN
          </a>
        </div>

        <!-- Social links — desktop -->
        <div class="hidden xl:flex items-center gap-3 ml-1">
          <a
            href={SOCIAL.github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors flex items-center gap-1"
            aria-label="GitHub de Ezequiel Gonzalez"
          >
            GitHub
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
          <a
            href={SOCIAL.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors flex items-center gap-1"
            aria-label="LinkedIn de Ezequiel Gonzalez"
          >
            LinkedIn
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>

        <div class="w-px h-4 bg-rim hidden sm:block" aria-hidden="true"></div>

        <!-- Theme toggle -->
        <ThemeToggle />

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden flex flex-col justify-center gap-1.5 w-8 h-8 p-1 cursor-pointer"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-full h-px bg-ink-2 transition-transform origin-center" id="ham-top"></span>
          <span class="block w-full h-px bg-ink-2 transition-opacity" id="ham-mid"></span>
          <span class="block w-full h-px bg-ink-2 transition-transform origin-center" id="ham-bot"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-rim bg-surface"
    role="navigation"
    aria-label="Menú móvil"
  >
    <nav class="wrap py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-mono text-xs text-ink-2 hover:text-gold py-2.5 border-b border-rim/50 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-4 pt-3 pb-2 border-b border-rim/50">
        <button
          type="button"
          data-open-cmd
          class="flex items-center gap-2 font-mono text-2xs text-gold py-1"
        >
          ⌘ Abrir Command Palette (Ctrl+K)
        </button>
      </div>
      <div class="flex gap-6 pt-3">
        <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors">
          GitHub ↗
        </a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors">
          LinkedIn ↗
        </a>
        <a href={`mailto:${SOCIAL.email}`} class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors">
          Email
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamTop = document.getElementById('ham-top');
    const hamMid = document.getElementById('ham-mid');
    const hamBot = document.getElementById('ham-bot');

    if (!btn || !menu || !hamTop || !hamMid || !hamBot) return;

    let open = false;

    const closeMenu = () => {
      open = false;
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      hamTop.style.transform = '';
      hamMid.style.opacity = '';
      hamBot.style.transform = '';
    };

    const toggleMenu = () => {
      open = !open;
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));

      // Animación hamburger → X
      if (open) {
        hamTop.style.transform = 'rotate(45deg) translateY(6px)';
        hamMid.style.opacity = '0';
        hamBot.style.transform = 'rotate(-45deg) translateY(-6px)';
      } else {
        closeMenu();
      }
    };

    btn.addEventListener('click', toggleMenu);

    // Cerrar al hacer click en un link del menú móvil
    menu.querySelectorAll('a, button').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        closeMenu();
        btn.focus();
      }
    });

    // Cerrar si redimensiona a desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && open) {
        closeMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
