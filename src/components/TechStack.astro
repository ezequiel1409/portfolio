---
import { TECH } from '../data/portfolio.data';
---

<section id="stack" class="section-rule" aria-labelledby="stack-heading">
  <div class="wrap">

    <header class="mb-12">
      <p class="eyebrow mb-4">Stack</p>
      <h2 id="stack-heading" class="font-display text-3xl md:text-4xl text-ink tracking-tighter">
        Tecnologías en producción
      </h2>
      <p class="text-ink-2 text-sm mt-3 max-w-xl">
        No es una lista de cosas que usé una vez. Es lo que usé en proyectos
        financieros reales, con carga real, con consecuencias reales.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {TECH.map((category) => (
        <div>
          <h3 class="font-mono text-2xs uppercase tracking-widest text-ink-3 mb-4 pb-2 border-b border-rim">
            {category.label}
          </h3>
          <ul class="flex flex-col gap-2.5" role="list">
            {category.items.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-2 group/item">
                <span
                  class="text-gold text-xs group-hover/item:translate-x-0.5 transition-transform"
                  aria-hidden="true"
                >
                  →
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
