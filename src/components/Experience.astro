---
import { EXPERIENCE } from '../data/portfolio.data';
---

<section id="experience" class="section-rule" aria-labelledby="experience-heading">
  <div class="wrap">

    <header class="mb-12">
      <p class="eyebrow mb-4">Experiencia</p>
      <h2 id="experience-heading" class="font-display text-3xl md:text-4xl text-ink tracking-tighter">
        4+ años en sistemas<br class="hidden sm:inline" /> de alta disponibilidad
      </h2>
    </header>

    <div class="relative">
      <!-- Línea vertical del timeline -->
      <div
        class="absolute left-0 top-2 bottom-2 w-px bg-rim hidden md:block"
        aria-hidden="true"
      ></div>

      <div class="flex flex-col gap-10">
        {EXPERIENCE.map((entry, idx) => (
          <article
            class="group relative md:pl-10"
            aria-label={`${entry.company} — ${entry.role}`}
          >
            <!-- Dot del timeline -->
            <div
              class:list={[
                'absolute left-0 top-1.5 w-2 h-2 rounded-full -translate-x-[3.5px] hidden md:block transition-colors',
                entry.current ? 'bg-gold' : 'bg-rim-active group-hover:bg-gold',
              ]}
              aria-hidden="true"
            ></div>

            <!-- Card -->
            <div class="border border-rim rounded-lg p-6 bg-surface hover:border-rim-active transition-colors duration-200">

              <!-- Header de la card -->
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-display text-base text-ink font-medium">
                      {entry.company}
                    </h3>
                    {entry.current && (
                      <span class="status-live text-2xs">actual</span>
                    )}
                  </div>
                  {entry.client && (
                    <p class="font-mono text-2xs text-ink-3 mt-0.5">
                      Client: {entry.client}
                    </p>
                  )}
                </div>

                <div class="text-right shrink-0">
                  <p class="font-mono text-2xs text-ink-3">{entry.period}</p>
                  <p class="font-mono text-2xs text-ink-3 mt-0.5">{entry.location}</p>
                </div>
              </div>

              <!-- Rol -->
              <p class="font-mono text-xs text-gold mb-4">{entry.role}</p>

              <!-- Bullets -->
              <ul class="flex flex-col gap-2.5 mb-5" role="list">
                {entry.bullets.map((bullet) => (
                  <li class="flex gap-3 text-sm text-ink-2 leading-relaxed">
                    <span class="text-gold shrink-0 mt-0.5" aria-hidden="true">›</span>
                    {bullet}
                  </li>
                ))}
              </ul>

              <!-- Stack badges -->
              <div class="flex flex-wrap gap-2" role="list" aria-label="Stack tecnológico">
                {entry.stack.map((tech) => (
                  <span class="badge" role="listitem">{tech}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
