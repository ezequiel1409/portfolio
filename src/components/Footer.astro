---
import { SOCIAL, getPortfolioData, type Locale } from '../data/portfolio.data';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const data = getPortfolioData(locale);
const { contact: t } = data.ui;
const credentials = data.credentials;
const isEn = locale === 'en';
const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const contactOptions = isEn
  ? [
      { id: 'scale', label: 'Backend performance & scaling bottleneck' },
      { id: 'new-api', label: 'Build a new API or product backend' },
      { id: 'legacy', label: 'Modernize or refactor legacy codebase' },
      { id: 'hire', label: 'Hire or add me to your engineering team' },
      { id: 'other', label: 'Other engineering challenge' },
    ]
  : [
      { id: 'scale', label: 'Cuello de botella de rendimiento o escala' },
      { id: 'new-api', label: 'Crear una nueva API o backend de producto' },
      { id: 'legacy', label: 'Modernizar o refactorizar código legacy' },
      { id: 'hire', label: 'Sumarme a tu equipo o proyecto' },
      { id: 'other', label: 'Otro desafío técnico' },
    ];
---

<footer id="contact" class="border-t border-rim mt-0 bg-surface/50" role="contentinfo">

  <!-- Contact CTA -->
  <div class="wrap py-20">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">{t.eyebrow}</p>
      <h2 class="font-display text-3xl md:text-4xl text-ink tracking-tighter mb-4 font-medium">
        {t.heading}
      </h2>
      <p class="text-ink-2 text-sm leading-relaxed mb-8">
        {t.body}
      </p>

      <!-- Selector interactivo de desafío -->
      <div class="mb-8 p-5 rounded-lg border border-rim bg-surface">
        <p class="font-mono text-xs text-ink-3 mb-3 uppercase tracking-wider">
          {isEn ? 'Select your primary interest to prefill email:' : 'Elegí el tema que querés consultar para preparar el mensaje:'}
        </p>
        <div class="flex flex-wrap gap-2" id="contact-chips">
          {contactOptions.map((opt, i) => (
            <button
              type="button"
              data-interest={opt.label}
              class:list={[
                'chip-btn px-3 py-1.5 rounded-sm border text-xs font-mono transition-all text-left cursor-pointer',
                i === 0
                  ? 'border-gold text-gold bg-gold/10'
                  : 'border-rim text-ink-2 hover:border-gold/60 hover:text-ink bg-surface-2/60',
              ]}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3.5">
        <!-- Escribirme -->
        <a
          id="btn-mailto-cta"
          href={`mailto:${SOCIAL.email}?subject=${encodeURIComponent(isEn ? 'Consultation: ' + contactOptions[0].label : 'Consulta: ' + contactOptions[0].label)}`}
          class="btn-primary"
          aria-label="Enviar email a Ezequiel Gonzalez"
        >
          <span id="btn-mailto-text">{t.sendEmail}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>

        <!-- Copiar Email -->
        <button
          id="btn-footer-copy-email"
          type="button"
          class="btn-ghost cursor-pointer"
          aria-label={t.copyEmailBtn}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span id="footer-copy-text">{t.copyEmailBtn}</span>
        </button>

        <!-- Descargar CV -->
        <a
          href={`${baseUrl}/cv-ezequiel-gonzalez.pdf`}
          download="Ezequiel_Gonzalez_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          aria-label={isEn ? 'Download Resume' : 'Descargar CV'}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {isEn ? 'Resume (PDF)' : 'CV (PDF)'}
        </a>

        <!-- LinkedIn -->
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          aria-label="Ver perfil de LinkedIn"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Educación y credenciales -->
  <div class="border-t border-rim">
    <div class="wrap py-10">
      <p class="font-mono text-2xs uppercase tracking-widest text-ink-3 mb-5">
        {t.credentialsTitle}
      </p>
      <div class="flex flex-col gap-3">
        {credentials.map((c) => (
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div class="flex items-baseline gap-2">
              <span class="text-sm text-ink">{c.label}</span>
              <span class="font-mono text-2xs text-ink-3">{c.org}</span>
            </div>
            {c.period && (
              <span class="font-mono text-2xs text-ink-2 shrink-0">{c.period}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-rim">
    <div class="wrap py-5 flex flex-wrap items-center justify-between gap-4">

      <!-- Brand pequeño -->
      <div class="flex items-center gap-2">
        <span
          class="w-6 h-6 flex items-center justify-center bg-gold text-canvas font-display text-2xs rounded-sm font-semibold"
          aria-hidden="true"
        >
          EG
        </span>
        <span class="font-mono text-2xs text-ink-2">
          © {year} Ezequiel Gonzalez · Full Stack & Cloud Developer
        </span>
      </div>

      <!-- Links -->
      <nav class="flex items-center gap-5" aria-label="Links de pie de página">
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${SOCIAL.email}`}
          class="font-mono text-2xs text-ink-2 hover:text-gold transition-colors"
        >
          Email
        </a>
      </nav>

      <!-- Build info -->
      <span class="font-mono text-2xs text-ink-3 hidden sm:inline">
        Astro 5 · 0 KB JS Runtime · Static
      </span>

    </div>
  </div>

</footer>

<script>
  function setupFooterInteractive() {
    const copyBtn = document.getElementById('btn-footer-copy-email');
    const copyText = document.getElementById('footer-copy-text');
    if (copyBtn && copyText) {
      const original = copyText.textContent;
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('ezequiel140901@gmail.com');
        copyText.textContent = document.documentElement.lang.startsWith('en') ? 'Copied!' : '¡Copiado!';
        copyBtn.classList.add('border-gold', 'text-gold');
        setTimeout(() => {
          copyText.textContent = original;
          copyBtn.classList.remove('border-gold', 'text-gold');
        }, 2000);
      });
    }

    // Chips de selección de desafío
    const mailtoBtn = document.getElementById('btn-mailto-cta') as HTMLAnchorElement;
    const chips = document.querySelectorAll<HTMLButtonElement>('#contact-chips .chip-btn');
    const isEn = document.documentElement.lang.startsWith('en');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove('border-gold', 'text-gold', 'bg-gold/10');
          c.classList.add('border-rim', 'text-ink-2', 'bg-surface-2/60');
        });
        chip.classList.add('border-gold', 'text-gold', 'bg-gold/10');
        chip.classList.remove('border-rim', 'text-ink-2', 'bg-surface-2/60');

        const interest = chip.getAttribute('data-interest') || '';
        if (mailtoBtn) {
          const subject = isEn ? `Consultation: ${interest}` : `Consulta: ${interest}`;
          const body = isEn
            ? `Hello Ezequiel,\n\nI am contacting you regarding: ${interest}.\n\nOur current challenge / project context is:\n\n`
            : `Hola Ezequiel,\n\nTe escribo para consultar sobre: ${interest}.\n\nEl contexto de nuestro proyecto / desafío técnico actual es:\n\n`;
          mailtoBtn.href = `mailto:ezequiel140901@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
      });
    });
  }

  setupFooterInteractive();
  document.addEventListener('astro:after-swap', setupFooterInteractive);
</script>
